# Copy this file to .env, then put your own values in place of these examples.
# .env holds secrets: it is never committed to Git.
DATABASE_URL="postgresql://user:password@host.neon.tech/neondb?sslmode=require"

ORIGIN="http://localhost:5173"

# Make one with: npx auth secret
BETTER_AUTH_SECRET=""

# From resend.com. Leave it empty while you learn: the email is printed in the terminal instead.
RESEND_API_KEY=""
